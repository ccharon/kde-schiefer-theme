APPLETSRC = "plasma-org.kde.plasma.desktop-appletsrc"


def mouse_action(button, schiefer, plasma):
    key = f"{button};NoModifier"

    def read():
        v = kread(APPLETSRC, ["ActionPlugins", "0"], key)
        return None if v is None else v == schiefer

    def write(on):
        value = schiefer if on else plasma
        plasma_js(f'var a = ConfigFile({js_str(APPLETSRC)}, "ActionPlugins");\n'
                  f'var d = ConfigFile(a, "0");\n'
                  f'd.writeEntry({js_str(key)}, {js_str(value)});\n')
        RELOAD.add("plasma")
    return read, write


