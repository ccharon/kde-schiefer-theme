"""schiefer-config – Schalter und Paletten von Schiefer (Motif/CDE für KDE Plasma) ein- und ausschalten.

  schiefer-config                      wie „liste“
  schiefer-config liste                alle Schalter mit Zustand und Vorgabe
  schiefer-config <schalter> an|aus    Schalter setzen (sofort wirksam, soweit möglich)
  schiefer-config palette [<Name>]     Paletten zeigen bzw. eine anwenden (Farbschema + Arbeitsflächenfarben)
  schiefer-config standard             alle Schalter auf die Schiefer-Vorgabe setzen

Wirkt nur für den aufrufenden Benutzer (~/.config, ~/.local/share). Alle Werte stehen in den üblichen
KDE-Dateien; die Schiefer-eigenen in ~/.config/schieferrc.
"""
import configparser
import os
import re
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
DATA_HOME = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share")
DATA_DIRS = [d for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if d]

BACKDROP = "org.kde.schiefer.backdrop"
GTK_MARKE = "/* erzeugt von schiefer-config"


class Fehler(Exception):
    pass


def warn(text):
    print("Hinweis: " + text, file=sys.stderr)


def have(prog):
    return shutil.which(prog) is not None


def run(args, check=False):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        if check:
            raise Fehler(f"{args[0]}: {e}")
        return None
    if check and r.returncode != 0:
        raise Fehler(f"{' '.join(args[:2])} …: {(r.stderr or r.stdout).strip()}")
    return r


# ---------------------------------------------------------------- KConfig über kreadconfig6/kwriteconfig6

def kread(datei, gruppen, key, default=None):
    args = ["kreadconfig6", "--file", datei]
    for g in gruppen:
        args += ["--group", g]
    args += ["--key", key]
    r = run(args)
    if r is None:
        raise Fehler("kreadconfig6 fehlt (Paket kde-frameworks/kconfig)")
    v = r.stdout.rstrip("\n")
    return default if v == "" else v


def kwrite(datei, gruppen, key, wert, notify=False):
    """wert=None löscht den Schlüssel."""
    args = ["kwriteconfig6", "--file", datei]
    for g in gruppen:
        args += ["--group", g]
    args += ["--key", key]
    if notify:
        args.append("--notify")
    if wert is None:
        args.append("--delete")
    else:
        if isinstance(wert, bool):
            args += ["--type", "bool"]
            wert = "true" if wert else "false"
        args.append(str(wert))
    run(args, check=True)


def as_bool(v, default):
    if v is None:
        return default
    return str(v).strip().lower() in ("true", "1", "yes", "on")


# ---------------------------------------------------------------- Plasma-Skripte

def plasma_laeuft(versuche=10):
    # direkt nach refreshCurrentShell (vorheriger Aufruf) antwortet plasmashell kurz nicht
    for i in range(versuche):
        r = run(["qdbus6", "org.kde.plasmashell", "/PlasmaShell"])
        if r is not None and r.returncode == 0:
            return True
        if i == 0 and not ist_plasma_prozess():
            return False
        time.sleep(0.5)
    return False


def ist_plasma_prozess():
    r = run(["pgrep", "-u", str(os.getuid()), "-x", "plasmashell"])
    return r is not None and r.returncode == 0


def plasma_js(js):
    if not have("qdbus6"):
        raise Fehler("qdbus6 fehlt (Paket dev-qt/qttools mit USE=qdbus)")
    if not plasma_laeuft():
        raise Fehler("Plasma (plasmashell) läuft nicht – dieser Schalter braucht eine laufende Plasma-Sitzung")
    r = run(["qdbus6", "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript", js])
    if r is None or r.returncode != 0:
        raise Fehler("Plasma-Skript fehlgeschlagen: " + ((r.stderr or r.stdout).strip() if r else "?"))
    return r.stdout.strip()


def js_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


# ---------------------------------------------------------------- Neuladen (gesammelt, am Ende einmal)

NEULADEN = set()


def neu_laden():
    if "stil" in NEULADEN and have("dbus-send"):
        run(["dbus-send", "--session", "--type=signal", "/SchieferStyle",
             "org.kde.Schiefer.Style.reparseConfiguration"])
    if "kwin" in NEULADEN and have("qdbus6"):
        r = run(["qdbus6", "org.kde.KWin", "/KWin", "reconfigure"])
        if r is None or r.returncode != 0:
            warn("KWin nicht erreichbar – Änderung wirkt nach dem nächsten Anmelden")
    if "plasma" in NEULADEN and have("qdbus6") and plasma_laeuft():
        run(["qdbus6", "org.kde.plasmashell", "/PlasmaShell", "refreshCurrentShell"])
    if "gtk" in NEULADEN:
        gtk_neu_laden()
    if "programme" in NEULADEN:
        warn("bereits laufende Programme übernehmen die Änderung erst nach einem Neustart")


# ---------------------------------------------------------------- GTK-Überlagerung

def gtk_basis():
    """Verzeichnis des installierten Schiefer-GTK-Themes (nicht die Überlagerung)."""
    for d in DATA_DIRS:
        p = os.path.join(d, "themes", "Schiefer")
        if os.path.realpath(p) == os.path.realpath(gtk_overlay()):
            continue
        if os.path.isfile(os.path.join(p, "optionen.txt")) and not ist_overlay(p):
            return p
    raise Fehler("GTK-Theme Schiefer mit optionen.txt nicht gefunden (in $XDG_DATA_DIRS/themes/Schiefer)")


def gtk_overlay():
    return os.path.join(DATA_HOME, "themes", "Schiefer")


def ist_overlay(p):
    try:
        with open(os.path.join(p, "gtk-3.0", "gtk.css"), encoding="utf-8") as f:
            return f.readline().startswith(GTK_MARKE)
    except OSError:
        return False


def gtk_optionen():
    """[(name, datei, beschreibung, standard)] aus optionen.txt"""
    out = []
    with open(os.path.join(gtk_basis(), "optionen.txt"), encoding="utf-8") as f:
        for z in f:
            z = z.strip()
            if not z or z.startswith("#"):
                continue
            teile = [t.strip() for t in z.split("|")]
            if len(teile) == 4:
                out.append((teile[0], teile[1], teile[2], teile[3] == "an"))
    return out


def gtk_zustand():
    """{name: bool}; ohne Überlagerung gelten die Vorgaben."""
    opts = gtk_optionen()
    ov = gtk_overlay()
    if not ist_overlay(ov):
        return {n: std for n, _, _, std in opts}
    with open(os.path.join(ov, "gtk-3.0", "gtk.css"), encoding="utf-8") as f:
        text = f.read()
    return {n: ("/" + datei + '")') in text for n, datei, _, _ in opts}


def gtk_setzen(name, an):
    opts = gtk_optionen()
    zustand = gtk_zustand()
    zustand[name] = an
    ov = gtk_overlay()
    if os.path.exists(ov) and not ist_overlay(ov):
        raise Fehler(f"{ov} ist kein von schiefer-config erzeugtes Theme (eigene Installation?) – "
                     "bitte selbst entfernen oder umbenennen")
    if all(zustand[n] == std for n, _, _, std in opts):
        if os.path.exists(ov):
            shutil.rmtree(ov)
        NEULADEN.add("gtk")
        return
    basis = gtk_basis()
    aus = {datei for n, datei, _, _ in opts if not zustand[n]}
    tmp = ov + ".neu"
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp)
    shutil.copy(os.path.join(basis, "index.theme"), tmp)
    for v in ("gtk-3.0", "gtk-4.0"):
        os.makedirs(os.path.join(tmp, v))
        zeilen = [f"{GTK_MARKE} aus {basis}/{v}/gtk.css – nicht von Hand ändern.\n",
                  f" * Abgeschaltet: {', '.join(sorted(aus)) or '–'} */\n"]
        with open(os.path.join(basis, v, "gtk.css"), encoding="utf-8") as f:
            for z in f:
                m = re.match(r'\s*@import\s+url\("([^"]+)"\)\s*;', z)
                if not m:
                    continue
                url = m.group(1)
                if url.startswith("file://"):
                    zeilen.append(z if z.endswith("\n") else z + "\n")
                    continue
                if os.path.basename(url) in aus:
                    continue
                zeilen.append(f'@import url("file://{os.path.join(basis, v, url)}");\n')
        with open(os.path.join(tmp, v, "gtk.css"), "w", encoding="utf-8") as f:
            f.writelines(zeilen)
    shutil.rmtree(ov, ignore_errors=True)
    os.makedirs(os.path.dirname(ov), exist_ok=True)
    os.rename(tmp, ov)
    NEULADEN.add("gtk")


def gtk_neu_laden():
    # GTK liest das Theme neu, wenn sich der Theme-Name ändert: kurz umschalten (gsettings → xsettings/Portal)
    if not have("gsettings"):
        warn("GTK-Programme übernehmen die Änderung nach einem Neustart")
        return
    r = run(["gsettings", "get", "org.gnome.desktop.interface", "gtk-theme"])
    if r is None or r.returncode != 0 or r.stdout.strip().strip("'") != "Schiefer":
        warn("GTK-Theme ist nicht Schiefer – Änderung wirkt, sobald Schiefer gewählt ist")
        return
    run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "Breeze"])
    time.sleep(0.5)
    run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "Schiefer"])
    warn("GTK: laufende Programme werden neu gezeichnet; falls nicht, Programm neu starten")


# ---------------------------------------------------------------- Schalter-Register

class Schalter:
    def __init__(self, name, bereich, beschreibung, standard, lesen, schreiben):
        self.name, self.bereich, self.beschreibung = name, bereich, beschreibung
        self.standard, self.lesen, self.schreiben = standard, lesen, schreiben


def schieferrc(gruppe, key, standard, neuladen):
    def lesen():
        return as_bool(kread("schieferrc", [gruppe], key), standard)

    def schreiben(an):
        kwrite("schieferrc", [gruppe], key, an)
        NEULADEN.add(neuladen)
    return lesen, schreiben


def raute_lesen():
    qt = as_bool(kread("schieferrc", ["Style"], "RadioDiamond"), True)
    try:
        gtk = gtk_zustand().get("raute", True)
    except Fehler:
        gtk = qt
    return qt if qt == gtk else None


def raute_schreiben(an):
    kwrite("schieferrc", ["Style"], "RadioDiamond", an)
    NEULADEN.add("stil")
    try:
        gtk_setzen("raute", an)
    except Fehler as e:
        warn(f"GTK nicht geändert: {e}")


def kopfleiste_lesen():
    return gtk_zustand().get("kopfleiste", True)


def kopfleiste_schreiben(an):
    gtk_setzen("kopfleiste", an)


APPLETSRC = "plasma-org.kde.plasma.desktop-appletsrc"


def maus_aktion(knopf, schiefer, plasma):
    key = f"{knopf};NoModifier"

    def lesen():
        v = kread(APPLETSRC, ["ActionPlugins", "0"], key)
        return None if v is None else v == schiefer

    def schreiben(an):
        wert = schiefer if an else plasma
        plasma_js(f'var a = ConfigFile({js_str(APPLETSRC)}, "ActionPlugins");\n'
                  f'var d = ConfigFile(a, "0");\n'
                  f'd.writeEntry({js_str(key)}, {js_str(wert)});\n')
        NEULADEN.add("plasma")
    return lesen, schreiben


def tabbox_lesen():
    return kread("kwinrc", ["TabBox"], "LayoutName") == "schiefer"


def tabbox_schreiben(an):
    kwrite("kwinrc", ["TabBox"], "LayoutName", "schiefer" if an else None)
    NEULADEN.add("kwin")


START_KEYS = ["icon", "useCustomButtonImage", "customButtonImage"]


def kicker_lesen():
    if plasma_laeuft():
        out = plasma_js('var t = [];\nfor (var i = 0; i < panels().length; i++) {\n'
                        '  var ws = panels()[i].widgets();\n'
                        '  for (var j = 0; j < ws.length; j++) t.push(ws[j].type);\n}\nprint(t.join(","));')
        typen = out.split(",")
    else:
        try:
            with open(os.path.join(CONFIG_HOME, APPLETSRC), encoding="utf-8") as f:
                typen = re.findall(r"^plugin=(\S+)", f.read(), re.M)
        except OSError:
            return None
    if "org.kde.plasma.kicker" in typen:
        return True
    if "org.kde.plasma.kickoff" in typen:
        return False
    return None


def kicker_schreiben(an):
    alt, neu = ("org.kde.plasma.kickoff", "org.kde.plasma.kicker") if an else \
               ("org.kde.plasma.kicker", "org.kde.plasma.kickoff")
    keys = "[" + ",".join(js_str(k) for k in START_KEYS) + "]"
    # Schritt 1: ersetzen; Ausgabe je Ersatz „Leiste:alteID:neueID:AppletOrder“
    out = plasma_js(f"""var keys = {keys}, r = [];
for (var pi = 0; pi < panels().length; pi++) {{
    var p = panels()[pi];
    var ws = p.widgets();
    for (var i = 0; i < ws.length; i++) {{
        var w = ws[i];
        if (w.type !== {js_str(alt)}) continue;
        var sc = w.globalShortcut, werte = {{}};
        w.currentConfigGroup = ["General"];
        for (var k = 0; k < keys.length; k++) werte[keys[k]] = w.readConfig(keys[k], "");
        p.currentConfigGroup = ["General"];
        var order = String(p.readConfig("AppletOrder", ""));
        var altId = w.id;
        w.remove();
        var x = p.addWidget({js_str(neu)});
        x.globalShortcut = sc;
        x.currentConfigGroup = ["General"];
        for (var k = 0; k < keys.length; k++) if (werte[keys[k]] !== "") x.writeConfig(keys[k], werte[keys[k]]);
        r.push(p.id + ":" + altId + ":" + x.id + ":" + order);
    }}
}}
print(r.join("\\n"));""")
    ersatz = [z.split(":", 3) for z in out.splitlines() if z.count(":") >= 3]
    if not ersatz:
        warn(f"kein Starter {alt} in den Leisten gefunden – nichts geändert")
        return False
    # Schritt 2: Plasma 6 ordnet die Leiste nach General/AppletOrder und schreibt sie nach addWidget
    # verzögert neu (neues Applet am Ende) – deshalb erst danach die alte Stelle wiederherstellen
    time.sleep(1)
    for leiste, alt_id, neu_id, order in ersatz:
        ids = [i for i in order.split(";") if i]
        if alt_id not in ids:
            continue
        soll = ";".join(neu_id if i == alt_id else i for i in ids)
        plasma_js(f"""var p = panelById({leiste});
p.currentConfigGroup = ["General"];
p.writeConfig("AppletOrder", {js_str(soll)});
p.reloadConfig();""")


def backdrop_lesen(key, standard):
    def lesen():
        if not plasma_laeuft():
            return None
        out = plasma_js(f"""var r = [];
var ds = desktops();
for (var i = 0; i < ds.length; i++) {{
    if (ds[i].wallpaperPlugin !== {js_str(BACKDROP)}) continue;
    ds[i].currentConfigGroup = ["Wallpaper", {js_str(BACKDROP)}, "General"];
    r.push(String(ds[i].readConfig({js_str(key)}, {"true" if standard else "false"})));
}}
print(r.join(","));""")
        werte = {as_bool(v, standard) for v in out.split(",") if v}
        if not werte:
            return None
        return werte.pop() if len(werte) == 1 else None
    return lesen


def backdrop_schreiben_wert(key, wert_js):
    out = plasma_js(f"""var n = 0;
var ds = desktops();
for (var i = 0; i < ds.length; i++) {{
    if (ds[i].wallpaperPlugin !== {js_str(BACKDROP)}) continue;
    ds[i].currentConfigGroup = ["Wallpaper", {js_str(BACKDROP)}, "General"];
    ds[i].writeConfig({js_str(key)}, {wert_js});
    ds[i].reloadConfig();
    n++;
}}
print(n);""")
    if out == "0":
        warn("keine Arbeitsfläche nutzt das Schiefer-Hintergrund-Plugin – nichts geändert "
             "(schiefer-config muster-hintergrund an)")
        return False
    return True


def backdrop(key, standard):
    def schreiben(an):
        return backdrop_schreiben_wert(key, "true" if an else "false")
    return backdrop_lesen(key, standard), schreiben


def muster_lesen():
    if not plasma_laeuft():
        return None
    out = plasma_js('var r = []; var ds = desktops();\n'
                    'for (var i = 0; i < ds.length; i++) r.push(ds[i].wallpaperPlugin);\nprint(r.join(","));')
    werte = {v == BACKDROP for v in out.split(",") if v}
    return werte.pop() if len(werte) == 1 else None


def muster_schreiben(an):
    plugin = BACKDROP if an else "org.kde.image"
    plasma_js(f"""var ds = desktops();
for (var i = 0; i < ds.length; i++) ds[i].wallpaperPlugin = {js_str(plugin)};""")
    if an:
        # Arbeitsflächenfarben der aktuellen Palette übernehmen (das Plugin kann das Schema nicht selbst lesen)
        schema = kread("kdeglobals", ["General"], "ColorScheme", "")
        for kurz, (name, pfad) in paletten().items():
            if name == schema:
                arbeitsflaechenfarben(pfad)


