class Error(Exception):
    pass


def warn(text):
    print(tr("Note: ", "Hinweis: ") + text, file=sys.stderr)


def have(prog):
    return shutil.which(prog) is not None


def run(args, check=False):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        if check:
            raise Error(f"{args[0]}: {e}")
        return None
    if check and r.returncode != 0:
        raise Error(f"{' '.join(args[:2])} ...: {(r.stderr or r.stdout).strip()}")
    return r


# ---------------------------------------------------------------- KConfig via kreadconfig6/kwriteconfig6

def kread(file, groups, key, default=None):
    args = ["kreadconfig6", "--file", file]
    for g in groups:
        args += ["--group", g]
    args += ["--key", key]
    r = run(args)
    if r is None:
        raise Error(tr("kreadconfig6 is missing (package kde-frameworks/kconfig)",
                       "kreadconfig6 fehlt (Paket kde-frameworks/kconfig)"))
    v = r.stdout.rstrip("\n")
    return default if v == "" else v


def kwrite(file, groups, key, value, notify=False):
    """value=None deletes the key."""
    args = ["kwriteconfig6", "--file", file]
    for g in groups:
        args += ["--group", g]
    args += ["--key", key]
    if notify:
        args.append("--notify")
    if value is None:
        args.append("--delete")
    else:
        if isinstance(value, bool):
            args += ["--type", "bool"]
            value = "true" if value else "false"
        args.append(str(value))
    run(args, check=True)


def as_bool(v, default):
    if v is None:
        return default
    return str(v).strip().lower() in ("true", "1", "yes", "on")


# ---------------------------------------------------------------- Plasma scripting

def plasma_running(attempts=10):
    # plasmashell stops answering for a moment right after refreshCurrentShell
    for i in range(attempts):
        r = run(["qdbus6", "org.kde.plasmashell", "/PlasmaShell"])
        if r is not None and r.returncode == 0:
            return True
        if i == 0 and not plasma_process_exists():
            return False
        time.sleep(0.5)
    return False


def plasma_process_exists():
    r = run(["pgrep", "-u", str(os.getuid()), "-x", "plasmashell"])
    return r is not None and r.returncode == 0


def plasma_js(js):
    if not have("qdbus6"):
        raise Error(tr("qdbus6 is missing (package dev-qt/qttools with USE=qdbus)",
                       "qdbus6 fehlt (Paket dev-qt/qttools mit USE=qdbus)"))
    if not plasma_running():
        raise Error(tr("Plasma (plasmashell) is not running. This option needs a running Plasma session.",
                       "Plasma (plasmashell) läuft nicht. Dieser Schalter braucht eine laufende Plasma-Sitzung."))
    r = run(["qdbus6", "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript", js])
    if r is None or r.returncode != 0:
        raise Error(tr("Plasma script failed: ", "Plasma-Skript fehlgeschlagen: ")
                    + ((r.stderr or r.stdout).strip() if r else "?"))
    return r.stdout.strip()


def js_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


# ---------------------------------------------------------------- Reloading (collected, run once at the end)

RELOAD = set()


def reload_all():
    if "style" in RELOAD and have("dbus-send"):
        run(["dbus-send", "--session", "--type=signal", "/SchieferStyle",
             "org.kde.Schiefer.Style.reparseConfiguration"])
    if "kwin" in RELOAD and have("qdbus6"):
        r = run(["qdbus6", "org.kde.KWin", "/KWin", "reconfigure"])
        if r is None or r.returncode != 0:
            warn(tr("KWin not reachable. The change takes effect at the next login.",
                    "KWin nicht erreichbar. Die Änderung wirkt nach dem nächsten Anmelden."))
    if "plasma" in RELOAD and have("qdbus6") and plasma_running():
        run(["qdbus6", "org.kde.plasmashell", "/PlasmaShell", "refreshCurrentShell"])
    if "gtk" in RELOAD:
        gtk_reload()
    if "apps" in RELOAD:
        warn(tr("running applications pick up the change after a restart",
                "laufende Programme übernehmen die Änderung erst nach einem Neustart"))


# ---------------------------------------------------------------- GTK overlay
# Disabling a GTK option means building a theme overlay in ~/.local/share/themes/Schiefer that imports
# only the enabled parts of the installed theme.

def gtk_overlay():
    return os.path.join(DATA_HOME, "themes", "Schiefer")


def is_overlay(p):
    try:
        with open(os.path.join(p, "gtk-3.0", "gtk.css"), encoding="utf-8") as f:
            return f.readline().startswith(GTK_MARKERS)
    except OSError:
        return False


def gtk_base():
    """Directory of the installed Schiefer GTK theme (never the overlay)."""
    for d in DATA_DIRS:
        p = os.path.join(d, "themes", "Schiefer")
        if os.path.realpath(p) == os.path.realpath(gtk_overlay()):
            continue
        if os.path.isfile(os.path.join(p, "options.txt")) and not is_overlay(p):
            return p
    raise Error(tr("GTK theme Schiefer with options.txt not found (in $XDG_DATA_DIRS/themes/Schiefer)",
                   "GTK-Theme Schiefer mit options.txt nicht gefunden (in $XDG_DATA_DIRS/themes/Schiefer)"))


def gtk_options():
    """[(name, file, default)] from options.txt"""
    out = []
    with open(os.path.join(gtk_base(), "options.txt"), encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = [t.strip() for t in line.split("|")]
            if len(parts) == 4:
                out.append((parts[0], parts[1], parts[3] == "on"))
    return out


def gtk_state():
    """{name: bool}; without an overlay the defaults apply."""
    opts = gtk_options()
    ov = gtk_overlay()
    if not is_overlay(ov):
        return {n: default for n, _, default in opts}
    with open(os.path.join(ov, "gtk-3.0", "gtk.css"), encoding="utf-8") as f:
        text = f.read()
    for old, new in GTK_LEGACY_FILES.items():
        text = text.replace("/" + old + '")', "/" + new + '")')
    return {n: ("/" + file + '")') in text for n, file, _ in opts}


def gtk_set(name, on):
    opts = gtk_options()
    state = gtk_state()
    state[name] = on
    ov = gtk_overlay()
    if os.path.exists(ov) and not is_overlay(ov):
        raise Error(tr(f"{ov} was not generated by schiefer-config. Please remove or rename it yourself.",
                       f"{ov} wurde nicht von schiefer-config erzeugt. Bitte selbst entfernen oder umbenennen."))
    if all(state[n] == default for n, _, default in opts):
        if os.path.exists(ov):
            shutil.rmtree(ov)
        RELOAD.add("gtk")
        return
    base = gtk_base()
    disabled = {file for n, file, _ in opts if not state[n]}
    tmp = ov + ".new"
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp)
    shutil.copy(os.path.join(base, "index.theme"), tmp)
    for v in ("gtk-3.0", "gtk-4.0"):
        os.makedirs(os.path.join(tmp, v))
        lines = [f"{GTK_MARKER} from {base}/{v}/gtk.css. Do not edit.\n",
                 f" * Disabled: {', '.join(sorted(disabled)) or '-'} */\n"]
        with open(os.path.join(base, v, "gtk.css"), encoding="utf-8") as f:
            for line in f:
                m = re.match(r'\s*@import\s+url\("([^"]+)"\)\s*;', line)
                if not m:
                    continue
                url = m.group(1)
                if url.startswith("file://"):
                    lines.append(line if line.endswith("\n") else line + "\n")
                    continue
                if os.path.basename(url) in disabled:
                    continue
                lines.append(f'@import url("file://{os.path.join(base, v, url)}");\n')
        with open(os.path.join(tmp, v, "gtk.css"), "w", encoding="utf-8") as f:
            f.writelines(lines)
    shutil.rmtree(ov, ignore_errors=True)
    os.makedirs(os.path.dirname(ov), exist_ok=True)
    os.rename(tmp, ov)
    RELOAD.add("gtk")


def gtk_reload():
    # GTK reloads its theme when the theme name changes, so switch away and back.
    if not have("gsettings"):
        warn(tr("GTK applications pick up the change after a restart",
                "GTK-Programme übernehmen die Änderung nach einem Neustart"))
        return
    r = run(["gsettings", "get", "org.gnome.desktop.interface", "gtk-theme"])
    if r is None or r.returncode != 0 or r.stdout.strip().strip("'") != "Schiefer":
        warn(tr("the GTK theme is not Schiefer. The change applies once Schiefer is selected.",
                "das GTK-Theme ist nicht Schiefer. Die Änderung wirkt, sobald Schiefer gewählt ist."))
        return
    run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "Breeze"])
    time.sleep(0.5)
    run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "Schiefer"])
    warn(tr("GTK: running applications are redrawn. If not, restart the application.",
            "GTK: laufende Programme werden neu gezeichnet. Falls nicht, Programm neu starten."))


# ---------------------------------------------------------------- Option registry

class Option:
    def __init__(self, name, alias, area, desc_en, desc_de, default, read, write):
        self.name, self.alias, self.area = name, alias, area
        self.description = tr(desc_en, desc_de)
        self.default, self.read, self.write = default, read, write
        self.no_target = False


def schieferrc(group, key, default, reload):
    def read():
        return as_bool(kread("schieferrc", [group], key), default)

    def write(on):
        kwrite("schieferrc", [group], key, on)
        RELOAD.add(reload)
    return read, write


def diamond_read():
    qt = as_bool(kread("schieferrc", ["Style"], "RadioDiamond"), True)
    try:
        gtk = gtk_state().get("diamond", True)
    except Error:
        gtk = qt
    return qt if qt == gtk else None


def diamond_write(on):
    kwrite("schieferrc", ["Style"], "RadioDiamond", on)
    RELOAD.add("style")
    try:
        gtk_set("diamond", on)
    except Error as e:
        warn(tr(f"GTK unchanged: {e}", f"GTK nicht geändert: {e}"))


