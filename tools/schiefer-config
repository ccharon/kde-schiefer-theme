    Option("lockscreen", "sperrbildschirm", "Plasma",
           "Schiefer lock screen (copy of the Plasma shell in ~/.local/share/plasma/shells; off: Plasma lock screen)",
           "Sperrbildschirm im Schiefer-Stil (Kopie der Plasma-Shell in ~/.local/share/plasma/shells; "
           "aus: Plasma-Sperrbildschirm)",
           True, lambda: lock_read(), lambda on: lock_write(on)),
    # The dock widgets watch schieferrc themselves, so no reload is needed.
    Option("frontpanel-color", "frontpanel-farbe", "Dock",
           "Schiefer dock, its panels and drawers in the palette's CDE front panel color (off: window color)",
           "Schiefer-Dock, seine Leisten und Schubladen in der CDE-Frontpanel-Farbe der Palette (aus: Fensterfarbe)",
           True, *schieferrc("Dock", "FrontPanelColor", True, "dock")),
]
BY_NAME = {s.name: s for s in OPTIONS}
BY_NAME.update({s.alias: s for s in OPTIONS})
# "?" here means: no launcher in the panels (for example only the Schiefer dock), so nothing to toggle.
BY_NAME["kicker"].no_target = True


# ---------------------------------------------------------------- Palettes

def palettes():
    """{short name: (scheme name, path)} of all installed Schiefer color schemes"""
    out = {}
    for d in [DATA_HOME] + DATA_DIRS:
        cs = os.path.join(d, "color-schemes")
        try:
            names = sorted(os.listdir(cs))
        except OSError:
            continue
        for fn in names:
            if not (fn.startswith("Schiefer") and fn.endswith(".colors")):
                continue
            scheme = fn[:-len(".colors")]
            short = (scheme[len("Schiefer"):] or "Schiefer").lower()
            out.setdefault(short, (scheme, os.path.join(cs, fn)))
    return out


def read_scheme(path):
    cp = configparser.ConfigParser(interpolation=None, strict=False)
    cp.optionxform = str
    cp.read(path, encoding="utf-8")
    return cp


def apply_desktop_colors(path):
    """Copy the scheme's DesktopColors into the backdrop plugin. The single color (per-desktop off)
    becomes the first of them so it matches the palette."""
    colors = read_scheme(path).get("Schiefer", "DesktopColors", fallback="").strip()
    if not colors:
        return False
    if not backdrop_write_value("DesktopColors", js_str(colors)):
        return False
    return backdrop_write_value("Color", js_str(colors.split(",")[0].strip()))


def palette(name):
    available = palettes()
    current = kread("kdeglobals", ["General"], "ColorScheme", "")
    if name is None:
        for short, (scheme, path) in sorted(available.items(), key=lambda x: (x[0] != "schiefer", x[0])):
            title = read_scheme(path).get("General", "Name", fallback=scheme)
            print(f"{'*' if scheme == current else ' '} {short:12} {title}")
        if not available:
            print(tr("no Schiefer color schemes found", "keine Schiefer-Farbschemata gefunden"))
        return
    short = name.lower()
    if short.startswith("schiefer") and short != "schiefer":
        short = short[len("schiefer"):].strip()
    # Scheme IDs are German; the English display names are accepted too.
    short = {"sandstone": "sandstein", "granite": "granit"}.get(short, short)
    if short not in available:
        raise Error(tr(f"unknown palette {name} (available: {', '.join(sorted(available))})",
                       f"Palette {name} unbekannt (vorhanden: {', '.join(sorted(available))})"))
    scheme, path = available[short]
    r = run(["plasma-apply-colorscheme", scheme]) if have("plasma-apply-colorscheme") else None
    if r is None or r.returncode != 0:
        raise Error(tr("plasma-apply-colorscheme failed", "plasma-apply-colorscheme fehlgeschlagen")
                    + (": " + (r.stderr or r.stdout).strip() if r else ""))
    print(tr(f"Color scheme: {scheme}", f"Farbschema: {scheme}"))
    if not plasma_running():
        warn(tr("Plasma is not running. Desktop colors not applied.",
                "Plasma läuft nicht. Arbeitsflächenfarben nicht übernommen."))
    elif apply_desktop_colors(path):
        print(tr("Desktop colors applied", "Arbeitsflächenfarben übernommen"))
    # The dock reads its colors from the scheme itself; GTK follows through kde-gtk-config.


# ---------------------------------------------------------------- Lock screen
# Plasma 6 loads the lock screen only from the shell package (plasmashellrc [Shell] ShellPackage), and a
# separate shell package would mean a separate panel configuration. So the installed Plasma shell is copied
# to ~/.local/share (same ID, takes precedence) with contents/lockscreen replaced by Schiefer's files.
# Symlinks fail because KPackage rejects paths outside the package. The login script
# /etc/xdg/plasma-workspace/env/schiefer-lockscreen.sh refreshes the copy after updates.
SHELL_ID = "org.kde.plasma.desktop"
LOCK_MARKER = ".schiefer-lockscreen"
LOCK_MARKERS = (LOCK_MARKER, ".schiefer-sperrbildschirm")


def lock_target():
    return os.path.join(DATA_HOME, "plasma", "shells", SHELL_ID)


def lock_is_ours(target):
    return any(os.path.exists(os.path.join(target, m)) for m in LOCK_MARKERS)


def lock_sources():
    """(installed Plasma shell, Schiefer lock screen), never the user's copy."""
    shell = next((os.path.join(d, "plasma", "shells", SHELL_ID) for d in DATA_DIRS
                  if os.path.realpath(d) != os.path.realpath(DATA_HOME)
                  and os.path.isfile(os.path.join(d, "plasma", "shells", SHELL_ID, "metadata.json"))), None)
    ours = os.environ.get("SCHIEFER_LOCKSCREEN_DIR") or next(
        (os.path.join(d, "schiefer", "lockscreen") for d in DATA_DIRS
         if os.path.isfile(os.path.join(d, "schiefer", "lockscreen", "SchieferLock.qml"))), None)
    return shell, ours


def lock_read():
    target = lock_target()
    if not os.path.lexists(target):
        return False
    return True if lock_is_ours(target) else None


def lock_fingerprint(shell, ours):
    """Hash over names, sizes and times of both sources; changes after Plasma or Schiefer updates."""
    parts = []
    for base in (shell, ours):
        for root, _, files in os.walk(base, followlinks=True):
            for name in sorted(files):
                p = os.path.join(root, name)
                try:
                    st = os.stat(p)
                except OSError:
                    continue
                parts.append(f"{os.path.relpath(p, base)}:{st.st_size}:{int(st.st_mtime)}")
    return hashlib.sha256("\n".join(parts).encode()).hexdigest()


def lock_build(only_if_stale=False):
    shell, ours = lock_sources()
    if not shell:
        raise Error(tr(f"Plasma shell {SHELL_ID} not found", f"Plasma-Shell {SHELL_ID} nicht gefunden"))
    if not ours:
        raise Error(tr("Schiefer lock screen is not installed (.../share/schiefer/lockscreen)",
                       "Schiefer-Sperrbildschirm ist nicht installiert (.../share/schiefer/lockscreen)"))
    target = lock_target()
    if os.path.lexists(target) and not lock_is_ours(target):
        raise Error(tr(f"{target} does not belong to Schiefer. Left untouched.",
                       f"{target} gehört nicht zu Schiefer. Nicht angefasst."))
    fp = lock_fingerprint(shell, ours)
    marker = os.path.join(target, LOCK_MARKER)
    if only_if_stale and os.path.exists(marker):
        with open(marker) as f:
            if f"fingerprint={fp}" in f.read():
                return
    new = target + ".schiefer-new"
    shutil.rmtree(new, ignore_errors=True)
    shutil.copytree(shell, new, symlinks=False)
    lockdir = os.path.join(new, "contents", "lockscreen")
    for name in os.listdir(ours):              # config.qml, LockOsd, MediaControls etc. stay from Plasma
        src, dst = os.path.join(ours, name), os.path.join(lockdir, name)
        if os.path.isdir(dst) and not os.path.islink(dst):
            shutil.rmtree(dst)
        elif os.path.lexists(dst):
            os.remove(dst)
        if os.path.isdir(src):
            shutil.copytree(src, dst, symlinks=False)
        else:
            shutil.copy2(src, dst)
    with open(os.path.join(new, LOCK_MARKER), "w") as f:
        f.write(f"# generated by schiefer-config: copy of the Plasma shell with the Schiefer lock screen\n"
                f"shell={shell}\nschiefer={ours}\nfingerprint={fp}\n")
    old = target + ".schiefer-old"
    shutil.rmtree(old, ignore_errors=True)
    if os.path.lexists(target):
        os.rename(target, old)
    os.rename(new, target)
    shutil.rmtree(old, ignore_errors=True)


def lock_write(on):
    target = lock_target()
    if on:
        lock_build()
    elif lock_is_ours(target):
        shutil.rmtree(target)
    elif os.path.lexists(target):
        raise Error(tr(f"{target} does not belong to Schiefer. Left untouched.",
                       f"{target} gehört nicht zu Schiefer. Nicht angefasst."))


def lock_refresh():
    """At login: rebuild the copy if it is enabled and stale. Silent, works without Plasma."""
    if lock_read():
        lock_build(only_if_stale=True)


# ---------------------------------------------------------------- Commands

def state_text(v):
    return {True: tr("on", "an"), False: tr("off", "aus"), None: "?"}.get(v, str(v))


def list_options():
    rows = []
    for s in OPTIONS:
        try:
            z = state_text(s.read())
        except Error:
            z = "?"
        rows.append((s.name, z, state_text(s.default), s.area, s.description))
    current = kread("kdeglobals", ["General"], "ColorScheme", "?")
    rows.append(("palette", current, "Schiefer", tr("Colors", "Farben"),
                 tr("schiefer-config palette lists all", "schiefer-config palette zeigt alle")))
    w = max(len(z[0]) for z in rows)
    print(f"{tr('Option', 'Schalter'):{w}}  {tr('State', 'Zustand'):9} {tr('Default', 'Vorgabe'):9} "
          f"{tr('Area', 'Bereich'):12} {tr('Description', 'Beschreibung')}")
    for n, z, default, area, desc in rows:
        print(f"{n:{w}}  {z:9} {default:9} {area:12} {desc}")
    print(tr("\n? = mixed or unreadable (for example Plasma is not running).  Change: schiefer-config <option> on|off",
             "\n? = gemischt oder nicht lesbar (z. B. Plasma läuft nicht).  Ändern: schiefer-config <schalter> on|off"))


def set_option(s, value):
    on = {"on": True, "an": True, "ein": True, "off": False, "aus": False}.get(value.lower())
    if on is None:
        raise Error(f"{s.name}: on|off")
    if s.write(on) is not False:
        print(f"{s.name}: {state_text(on)}")


def defaults():
    errors = 0
    for s in OPTIONS:
        try:
            z = s.read()
            if z is None and s.no_target:
                continue
            if z != s.default:
                set_option(s, "on" if s.default else "off")
        except Error as e:
            print(f"{s.name}: {e}", file=sys.stderr)
            errors += 1
    return errors


def main(argv):
    sys.stdout.reconfigure(line_buffering=True)
    if not argv or argv[0] in ("list", "liste"):
        list_options()
        return 0
    cmd = argv[0]
    if cmd in ("-h", "--help", "help", "hilfe"):
        print(tr(HELP_EN, HELP_DE))
        return 0
    try:
        if cmd == "palette":
            palette(argv[1] if len(argv) > 1 else None)
        elif cmd in ("lockscreen-refresh", "sperrbildschirm-auffrischen"):
            lock_refresh()
            return 0
        elif cmd in ("defaults", "standard"):
            n = defaults()
            reload_all()
            return 1 if n else 0
        elif cmd in BY_NAME:
            if len(argv) != 2:
                raise Error(f"schiefer-config {cmd} on|off")
            set_option(BY_NAME[cmd], argv[1])
        else:
            raise Error(tr(f"unknown command: {cmd} (schiefer-config help)",
                           f"unbekannter Befehl: {cmd} (schiefer-config help)"))
    except Error as e:
        print(f"schiefer-config: {e}", file=sys.stderr)
        reload_all()
        return 1
    reload_all()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
