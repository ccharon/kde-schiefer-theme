LAUNCHER_KEYS = ["icon", "useCustomButtonImage", "customButtonImage"]


def kicker_read():
    if plasma_running():
        out = plasma_js('var t = [];\nfor (var i = 0; i < panels().length; i++) {\n'
                        '  var ws = panels()[i].widgets();\n'
                        '  for (var j = 0; j < ws.length; j++) t.push(ws[j].type);\n}\nprint(t.join(","));')
        types = out.split(",")
    else:
        try:
            with open(os.path.join(CONFIG_HOME, APPLETSRC), encoding="utf-8") as f:
                types = re.findall(r"^plugin=(\S+)", f.read(), re.M)
        except OSError:
            return None
    if "org.kde.plasma.kicker" in types:
        return True
    if "org.kde.plasma.kickoff" in types:
        return False
    return None


def kicker_write(on):
    old, new = ("org.kde.plasma.kickoff", "org.kde.plasma.kicker") if on else \
               ("org.kde.plasma.kicker", "org.kde.plasma.kickoff")
    keys = "[" + ",".join(js_str(k) for k in LAUNCHER_KEYS) + "]"
    # Step 1: replace. One output line per replacement: "panel:oldId:newId:AppletOrder"
    out = plasma_js(f"""var keys = {keys}, r = [];
for (var pi = 0; pi < panels().length; pi++) {{
    var p = panels()[pi];
    var ws = p.widgets();
    for (var i = 0; i < ws.length; i++) {{
        var w = ws[i];
        if (w.type !== {js_str(old)}) continue;
        var sc = w.globalShortcut, values = {{}};
        w.currentConfigGroup = ["General"];
        for (var k = 0; k < keys.length; k++) values[keys[k]] = w.readConfig(keys[k], "");
        p.currentConfigGroup = ["General"];
        var order = String(p.readConfig("AppletOrder", ""));
        var oldId = w.id;
        w.remove();
        var x = p.addWidget({js_str(new)});
        x.globalShortcut = sc;
        x.currentConfigGroup = ["General"];
        for (var k = 0; k < keys.length; k++) if (values[keys[k]] !== "") x.writeConfig(keys[k], values[keys[k]]);
        r.push(p.id + ":" + oldId + ":" + x.id + ":" + order);
    }}
}}
print(r.join("\\n"));""")
    replaced = [z.split(":", 3) for z in out.splitlines() if z.count(":") >= 3]
    if not replaced:
        warn(tr(f"no launcher {old} found in the panels. Nothing changed.",
                f"kein Starter {old} in den Leisten gefunden. Nichts geändert."))
        return False
    # Step 2: Plasma 6 rewrites General/AppletOrder shortly after addWidget (new applet last),
    # so the old position can only be restored afterwards.
    time.sleep(1)
    for panel, old_id, new_id, order in replaced:
        ids = [i for i in order.split(";") if i]
        if old_id not in ids:
            continue
        wanted = ";".join(new_id if i == old_id else i for i in ids)
        plasma_js(f"""var p = panelById({panel});
p.currentConfigGroup = ["General"];
p.writeConfig("AppletOrder", {js_str(wanted)});
p.reloadConfig();""")


def backdrop_read(key, default):
    def read():
        if not plasma_running():
            return None
        out = plasma_js(f"""var r = [];
var ds = desktops();
for (var i = 0; i < ds.length; i++) {{
    if (ds[i].wallpaperPlugin !== {js_str(BACKDROP)}) continue;
    ds[i].currentConfigGroup = ["Wallpaper", {js_str(BACKDROP)}, "General"];
    r.push(String(ds[i].readConfig({js_str(key)}, {"true" if default else "false"})));
}}
print(r.join(","));""")
        values = {as_bool(v, default) for v in out.split(",") if v}
        if not values:
            return None
        return values.pop() if len(values) == 1 else None
    return read


def backdrop_write_value(key, value_js):
    out = plasma_js(f"""var n = 0;
var ds = desktops();
for (var i = 0; i < ds.length; i++) {{
    if (ds[i].wallpaperPlugin !== {js_str(BACKDROP)}) continue;
    ds[i].currentConfigGroup = ["Wallpaper", {js_str(BACKDROP)}, "General"];
    ds[i].writeConfig({js_str(key)}, {value_js});
    ds[i].reloadConfig();
    n++;
}}
print(n);""")
    if out == "0":
        warn(tr("no desktop uses the Schiefer backdrop plugin. Nothing changed (schiefer-config pattern-backdrop on).",
                "keine Arbeitsfläche nutzt das Schiefer-Hintergrund-Plugin. Nichts geändert "
                "(schiefer-config pattern-backdrop on)."))
        return False
    return True


def backdrop(key, default):
    def write(on):
        return backdrop_write_value(key, "true" if on else "false")
    return backdrop_read(key, default), write


def pattern_read():
    if not plasma_running():
        return None
    out = plasma_js('var r = []; var ds = desktops();\n'
                    'for (var i = 0; i < ds.length; i++) r.push(ds[i].wallpaperPlugin);\nprint(r.join(","));')
    values = {v == BACKDROP for v in out.split(",") if v}
    return values.pop() if len(values) == 1 else None


def pattern_write(on):
    plugin = BACKDROP if on else "org.kde.image"
    plasma_js(f"""var ds = desktops();
for (var i = 0; i < ds.length; i++) ds[i].wallpaperPlugin = {js_str(plugin)};""")
    if on:
        # The plugin cannot read the color scheme itself, so copy the palette's desktop colors.
        scheme = kread("kdeglobals", ["General"], "ColorScheme", "")
        for short, (name, path) in palettes().items():
            if name == scheme:
                apply_desktop_colors(path)


def cursor_read():
    return kread("kcminputrc", ["Mouse"], "cursorTheme", "breeze_cursors") == "Schiefer"


def cursor_write(on):
    name = "Schiefer" if on else "breeze_cursors"
    dirs = [os.path.join(HOME, ".icons"), os.path.join(DATA_HOME, "icons")] + \
        [os.path.join(d, "icons") for d in DATA_DIRS]
    if not any(os.path.isdir(os.path.join(d, name, "cursors")) for d in dirs):
        raise Error(tr(f"cursor theme {name} is not installed", f"Zeigerthema {name} ist nicht installiert"))
    if have("plasma-apply-cursortheme"):
        r = run(["plasma-apply-cursortheme", name])
        if r is not None and r.returncode == 0:
            return
    # plasma-apply-cursortheme only searches the standard icon paths.
    kwrite("kcminputrc", ["Mouse"], "cursorTheme", name, notify=True)
    RELOAD.add("apps")


