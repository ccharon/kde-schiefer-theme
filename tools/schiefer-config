# ---------------------------------------------------------------- Paletten

def paletten():
    """{kurzname: (schemaname, pfad)} aller installierten Schiefer-Schemata"""
    out = {}
    for d in [DATA_HOME] + DATA_DIRS:
        cs = os.path.join(d, "color-schemes")
        try:
            namen = sorted(os.listdir(cs))
        except OSError:
            continue
        for fn in namen:
            if not (fn.startswith("Schiefer") and fn.endswith(".colors")):
                continue
            schema = fn[:-len(".colors")]
            kurz = (schema[len("Schiefer"):] or "Schiefer").lower()
            out.setdefault(kurz, (schema, os.path.join(cs, fn)))
    return out


def lies_schema(pfad):
    cp = configparser.ConfigParser(interpolation=None, strict=False)
    cp.optionxform = str
    cp.read(pfad, encoding="utf-8")
    return cp


def arbeitsflaechenfarben(pfad):
    """DesktopColors des Schemas ins Hintergrund-Plugin; die Einzelfarbe (je-arbeitsflaeche aus)
    wird die erste davon, damit sie zur Palette passt"""
    farben = lies_schema(pfad).get("Schiefer", "DesktopColors", fallback="").strip()
    if not farben:
        return False
    if not backdrop_schreiben_wert("DesktopColors", js_str(farben)):
        return False
    return backdrop_schreiben_wert("Color", js_str(farben.split(",")[0].strip()))


def palette(name):
    alle = paletten()
    aktuell = kread("kdeglobals", ["General"], "ColorScheme", "")
    if name is None:
        for kurz, (schema, pfad) in sorted(alle.items(), key=lambda x: (x[0] != "schiefer", x[0])):
            titel = lies_schema(pfad).get("General", "Name", fallback=schema)
            print(f"{'*' if schema == aktuell else ' '} {kurz:12} {titel}")
        if not alle:
            print("keine Schiefer-Farbschemata gefunden")
        return
    kurz = name.lower()
    if kurz.startswith("schiefer") and kurz != "schiefer":
        kurz = kurz[len("schiefer"):]
    if kurz not in alle:
        raise Fehler(f"Palette {name} unbekannt (vorhanden: {', '.join(sorted(alle))})")
    schema, pfad = alle[kurz]
    r = run(["plasma-apply-colorscheme", schema]) if have("plasma-apply-colorscheme") else None
    if r is None or r.returncode != 0:
        raise Fehler("plasma-apply-colorscheme fehlgeschlagen" + (": " + (r.stderr or r.stdout).strip() if r else ""))
    print(f"Farbschema: {schema}")
    if not plasma_laeuft():
        warn("Plasma läuft nicht – Arbeitsflächenfarben nicht übernommen")
    elif arbeitsflaechenfarben(pfad):
        print("Arbeitsflächenfarben übernommen")
    # Dock (Konsole, Icon Box) liest die Farben selbst aus dem Schema; GTK über kde-gtk-config


# ---------------------------------------------------------------- Befehle

def zustand_text(v):
    return {True: "an", False: "aus", None: "?"}.get(v, str(v))


def liste():
    zeilen = []
    for s in SCHALTER:
        try:
            z = zustand_text(s.lesen())
        except Fehler:
            z = "?"
        zeilen.append((s.name, z, zustand_text(s.standard), s.bereich, s.beschreibung))
    aktuell = kread("kdeglobals", ["General"], "ColorScheme", "?")
    zeilen.append(("palette", aktuell, "Schiefer", "Farben", "schiefer-config palette zeigt alle"))
    b = max(len(z[0]) for z in zeilen)
    print(f"{'Schalter':{b}}  {'Zustand':9} {'Vorgabe':9} {'Bereich':12} Beschreibung")
    for n, z, std, ber, besch in zeilen:
        print(f"{n:{b}}  {z:9} {std:9} {ber:12} {besch}")
    print("\n? = gemischt oder nicht lesbar (z. B. Plasma läuft nicht).  Ändern: schiefer-config <schalter> an|aus")


def setzen(s, wert):
    an = {"an": True, "ein": True, "on": True, "aus": False, "off": False}.get(wert.lower())
    if an is None:
        raise Fehler(f"{s.name}: an oder aus")
    if s.schreiben(an) is not False:
        print(f"{s.name}: {zustand_text(an)}")


def standard():
    fehler = 0
    for s in SCHALTER:
        try:
            z = s.lesen()
            if z is None and getattr(s, "ohne_ziel", False):
                continue
            if z != s.standard:
                setzen(s, "an" if s.standard else "aus")
        except Fehler as e:
            print(f"{s.name}: {e}", file=sys.stderr)
            fehler += 1
    return fehler


def main(argv):
    sys.stdout.reconfigure(line_buffering=True)
    if not argv or argv[0] in ("liste", "list"):
        liste()
        return 0
    cmd = argv[0]
    if cmd in ("-h", "--help", "hilfe"):
        print(__doc__.strip())
        return 0
    try:
        if cmd == "palette":
            palette(argv[1] if len(argv) > 1 else None)
        elif cmd == "standard":
            n = standard()
            neu_laden()
            return 1 if n else 0
        elif cmd in NACH_NAME:
            if len(argv) != 2:
                raise Fehler(f"schiefer-config {cmd} an|aus")
            setzen(NACH_NAME[cmd], argv[1])
        else:
            raise Fehler(f"unbekannt: {cmd} (schiefer-config hilfe)")
    except Fehler as e:
        print(f"schiefer-config: {e}", file=sys.stderr)
        neu_laden()
        return 1
    neu_laden()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
