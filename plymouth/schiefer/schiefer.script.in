# ------------------------------------------------------------------ geometry
Window.SetBackgroundTopColor(screen_r, screen_g, screen_b);
Window.SetBackgroundBottomColor(screen_r, screen_g, screen_b);
W = Window.GetWidth();
H = Window.GetHeight();
X0 = Window.GetX();
Y0 = Window.GetY();
# UI scale, one of the atlas sizes. The base follows the pixel height (1 below 1550 px, 2 up to 4K).
# With the screen height in mm (screen_mm, from the EDID, written by schiefer-plymouth-info) a dense
# panel goes up until a log line gets about LINE_MM. The EDID never lowers the base: large monitors are
# viewed from further away, so 6 mm on a 43" 4K screen is too small. At least MIN_ROWS lines of the small
# font fit on the screen.
# The names come from a table: Plymouth prints numbers with %g of the current locale ("1,5").
Scales = [1, 1.5, 2, 2.5, 3];
ScaleNames = ["1", "1.5", "2", "2.5", "3"];
LINE_MM = 6;
MIN_ROWS = 30;
Line1 = Fonts["mono-lit-1"].h;
Want = Math.Int(H / 1000 + 0.45);
if (screen_mm > 0 && H / screen_mm * LINE_MM / Line1 > Want) Want = H / screen_mm * LINE_MM / Line1;
Most = H / (MIN_ROWS * Line1);
K = 1;
KName = ScaleNames[0];
Si = 0;
while (Scales[Si]) {
    if (Scales[Si] <= Most && Math.Abs(Scales[Si] - Want) < Math.Abs(K - Want)) {
        K = Scales[Si];
        KName = ScaleNames[Si];
    }
    Si = Si + 1;
}
FMono = "mono-lit-" + KName;
FDark = "mono-dark-" + KName;
FHost = "host-" + KName;
LineH = Fonts[FMono].h;
CharW = Fonts[FMono].adv[33];          # "A"
U = Math.Int(LineH / 2);               # spacing unit

COLS = Math.Int((W - 8 * U) / CharW);
if (COLS > 100) COLS = 100;
ColW = COLS * CharW;
Left = X0 + Math.Int((W - ColW) / 2);
Top = Y0 + Math.Int(H * 0.07);

# ------------------------------------------------------------------ text helpers
# glyph index (1 based) of the character at byte position l_p; sets GlyphLen to its byte length
fun GlyphAt(l_font, l_s, l_p) {
    l_n = 3;
    while (l_n > 0) {
        l_key = l_s.SubString(l_p, l_p + l_n);
        l_idx = Fonts[l_font].map[l_key];
        if (l_idx) {
            GlyphLen = l_n;
            return l_idx;
        }
        l_n = l_n - 1;
    }
    GlyphLen = 1;
    return Fonts[l_font].map["?"];
}

fun GlyphImage(l_font, l_idx) {
    if (!Fonts[l_font].cache[l_idx])
        Fonts[l_font].cache[l_idx] = Fonts[l_font].img.Crop(Fonts[l_font].x[l_idx - 1], 0, Fonts[l_font].w[l_idx - 1], Fonts[l_font].h);
    return Fonts[l_font].cache[l_idx];
}

# text as a row of sprites; at most l_max characters (0 = no limit). Result: .spr[], .n, .w
fun Text(l_font, l_s, l_x, l_y, l_z, l_max) {
    l_t.n = 0;
    l_t.w = 0;
    l_p = 0;
    while (l_s.CharAt(l_p) != "" && (l_max == 0 || l_t.n < l_max)) {
        l_idx = GlyphAt(l_font, l_s, l_p);
        l_p = l_p + GlyphLen;
        if (l_idx != Fonts[l_font].map[" "]) {
            l_sp = Sprite(GlyphImage(l_font, l_idx));
            l_sp.SetPosition(l_x + l_t.w, l_y, l_z);
            l_t.spr[l_t.n] = l_sp;
            l_t.n = l_t.n + 1;
        }
        l_t.w = l_t.w + Fonts[l_font].adv[l_idx - 1];
    }
    l_t.y = l_y;
    return l_t;
}

fun TextMove(l_t, l_dy) {
    l_i = 0;
    while (l_i < l_t.n) {
        l_t.spr[l_i].SetY(l_t.spr[l_i].GetY() + l_dy);
        l_i = l_i + 1;
    }
    l_t.y = l_t.y + l_dy;
}

fun TextOpacity(l_t, l_o) {
    l_i = 0;
    while (l_i < l_t.n) {
        l_t.spr[l_i].SetOpacity(l_o);
        l_i = l_i + 1;
    }
}

fun Pad(l_n, l_width) {
    l_s = "" + l_n;
    while (l_s.CharAt(l_width - 1) == "") l_s = " " + l_s;
    return l_s;
}

# ------------------------------------------------------------------ Motif boxes from 1 px images
Img.panel = Image("panel.png");
Img.panelTop = Image("panel-top.png");
Img.panelBottom = Image("panel-bottom.png");
Img.field = Image("field.png");
Img.trough = Image("trough.png");
Img.troughTop = Image("trough-top.png");
Img.troughBottom = Image("trough-bottom.png");
Img.bar = Image("bar.png");
Img.barTop = Image("bar-top.png");
Img.barBottom = Image("bar-bottom.png");
Img.lit = Image("lit.png");
Img.ink = Image("ink.png");

fun Rect(l_img, l_x, l_y, l_w, l_h, l_z) {
    if (l_w < 1) l_w = 1;
    if (l_h < 1) l_h = 1;
    l_s = Sprite(l_img.Scale(l_w, l_h));
    l_s.SetPosition(l_x, l_y, l_z);
    return l_s;
}

# raised (l_sunken = 0) or sunken box with Motif edges of thickness l_d
fun Bevel(l_face, l_top, l_bottom, l_x, l_y, l_w, l_h, l_d, l_z, l_sunken) {
    if (l_sunken) {
        l_t = l_top;
        l_top = l_bottom;
        l_bottom = l_t;
    }
    l_b.face = Rect(l_face, l_x, l_y, l_w, l_h, l_z);
    l_b.t = Rect(l_top, l_x, l_y, l_w, l_d, l_z + 1);
    l_b.l = Rect(l_top, l_x, l_y, l_d, l_h, l_z + 1);
    l_b.b = Rect(l_bottom, l_x, l_y + l_h - l_d, l_w, l_d, l_z + 2);
    l_b.r = Rect(l_bottom, l_x + l_w - l_d, l_y, l_d, l_h, l_z + 2);
    return l_b;
}

# ------------------------------------------------------------------ banner
Mode = Plymouth.GetMode();
Booting = (Mode == "boot");
Edge = Math.Int(2 * K + 0.5);
Emblem = Image("emblem-" + KName + ".png");
BannerH = Emblem.GetHeight() + 4 * U;
Banner = Bevel(Img.panel, Img.panelTop, Img.panelBottom, Left, Top, ColW, BannerH, Edge, 10, 0);
EmblemSprite = Sprite(Emblem);
EmblemSprite.SetPosition(Left + 2 * U, Top + 2 * U, 12);

l0x = Left + 2 * U + Emblem.GetWidth() + 2 * U;
InfoMax = Math.Int((Left + ColW - 2 * U - l0x) / CharW);
HostText = Text(FHost, host, l0x, Top + 2 * U - Math.Int(U / 2), 12, 0);
l0y = Top + 2 * U + Fonts[FHost].h - Math.Int(U / 2);
Info0 = Text(FDark, os + "  ·  Kernel " + kernel, l0x, l0y, 12, InfoMax);
Info1 = Text(FDark, machine, l0x, l0y + LineH, 12, InfoMax);
Info2 = Text(FDark, cpu + "  ·  " + mem + " " + T.memory, l0x, l0y + 2 * LineH, 12, InfoMax);
if (l0y + 3 * LineH + 2 * U > Top + BannerH) {
    # the lines need more room than the emblem: stretch the banner
    BannerH = l0y + 3 * LineH + 2 * U - Top;
    Banner = Bevel(Img.panel, Img.panelTop, Img.panelBottom, Left, Top, ColW, BannerH, Edge, 10, 0);
}

DeviceLine = Text(FMono, T.device + ": " + root, Left, Top + BannerH + 2 * U, 5, COLS);
TextOpacity(DeviceLine, 0.7);

# ------------------------------------------------------------------ progress bar
BarH = 2 * U;
BarY = Y0 + H - Math.Int(H * 0.07) - BarH;
PercentW = 5 * CharW;
TroughW = ColW - PercentW - U;
if (Booting || Mode == "updates" || Mode == "system-upgrade" || Mode == "firmware-upgrade") {
    Trough = Bevel(Img.trough, Img.troughTop, Img.troughBottom, Left, BarY, TroughW, BarH, Edge, 10, 1);
}
BarFill = 0;
BarShown = -1;
PercentShown = -1;

fun ShowProgress(l_frac) {
    if (!Trough) return;
    if (l_frac < 0) l_frac = 0;
    if (l_frac > 1) l_frac = 1;
    l_inner = TroughW - 2 * Edge;
    l_w = Math.Int(l_inner * l_frac);
    if (l_w != BarShown && l_w >= 2 * Edge) {
        BarShown = l_w;
        BarFill = Bevel(Img.bar, Img.barTop, Img.barBottom, Left + Edge, BarY + Edge, l_w, BarH - 2 * Edge, Edge, 20, 0);
    }
    l_pc = Math.Int(l_frac * 100);
    if (l_pc != PercentShown) {
        PercentShown = l_pc;
        PercentText = Text(FMono, Pad(l_pc, 3) + " %", Left + ColW - PercentW, BarY + Math.Int((BarH - LineH) / 2), 20, 0);
    }
}

# ------------------------------------------------------------------ log
LogTop = Top + BannerH + 2 * U + 2 * LineH;
LogBottom = BarY - 2 * U;
if (!Trough) LogBottom = Y0 + H - Math.Int(H * 0.07);
# one row stays free below the log for a password or question prompt
Rows = Math.Int((LogBottom - LogTop) / LineH) - 1;
if (Rows < 3) Rows = 3;
NLines = 0;
Now = 0;
Cursor = Rect(Img.lit, Left, LogTop, CharW, LineH, 30);
Cursor.SetOpacity(0);

fun Stamp() {
    l_ms = Math.Int(Now * 1000 + 0.5);
    l_s = Math.Int(l_ms / 1000);
    l_f = "" + (l_ms - l_s * 1000);
    while (l_f.CharAt(2) == "") l_f = "0" + l_f;
    return "[" + Pad(l_s, 5) + "." + l_f + "]";
}

fun PlaceCursor() {
    if (NLines == 0) return;
    l_last = Lines[NLines - 1];
    Cursor.SetX(Left + l_last.w + CharW);
    Cursor.SetY(l_last.y);
}

# one log line: time stamp (dimmed) and text; .a, .b sprite rows, .w width, .y position
fun MakeLine(l_s, l_y) {
    l_ln.a = Text(FMono, Stamp(), Left, l_y, 5, 0);
    TextOpacity(l_ln.a, 0.5);
    l_ln.b = Text(FMono, l_s, Left + l_ln.a.w + CharW, l_y, 5, COLS - 16);
    l_ln.w = l_ln.a.w + CharW + l_ln.b.w;
    l_ln.y = l_y;
    return l_ln;
}

fun AddLine(l_s) {
    if (NLines < Rows) {
        Lines[NLines] = MakeLine(l_s, LogTop + NLines * LineH);
        NLines = NLines + 1;
    } else {
        # scroll: drop the top line, move the others up by one row
        l_i = 0;
        while (l_i < Rows - 1) {
            Lines[l_i] = Lines[l_i + 1];
            TextMove(Lines[l_i].a, -LineH);
            TextMove(Lines[l_i].b, -LineH);
            Lines[l_i].y = Lines[l_i].y - LineH;
            l_i = l_i + 1;
        }
        Lines[Rows - 1] = MakeLine(l_s, LogTop + (Rows - 1) * LineH);
    }
    PlaceCursor();
}

# systemd escapes "-" and other characters in unit names as \xNN; show the common ones plainly
fun Unescape(l_s) {
    l_out = "";
    l_p = 0;
    while (l_s.CharAt(l_p) != "") {
        l_c = l_s.CharAt(l_p);
        l_seq = l_s.SubString(l_p, l_p + 4);
        if (l_seq == "\\x2d") { l_out = l_out + "-"; l_p = l_p + 4; }
        else if (l_seq == "\\x20") { l_out = l_out + " "; l_p = l_p + 4; }
        else if (l_seq == "\\x5c") { l_out = l_out + "\\"; l_p = l_p + 4; }
        else { l_out = l_out + l_c; l_p = l_p + 1; }
    }
    return l_out;
}

# ------------------------------------------------------------------ password and question prompt
fun HidePrompt() {
    PromptField = NULL;
    PromptText = NULL;
    PromptBullets = NULL;
    Cursor.SetOpacity(0);
    PromptActive = 0;
    PlaceCursor();
}

# l_entry: visible text (question) or NULL; l_bullets: number of hidden characters (password)
fun ShowPrompt(l_label, l_entry, l_bullets) {
    # directly below the last log line, like a prompt on the console
    l_y = LogTop + NLines * LineH + Math.Int(U / 2);
    PromptText = Text(FMono, l_label, Left, l_y, 40, COLS - 32);
    l_fx = Left + PromptText.w + CharW;
    l_fw = 30 * CharW;
    PromptField = Bevel(Img.field, Img.panelTop, Img.panelBottom, l_fx, l_y - Math.Int(U / 2), l_fw, LineH + U, Edge, 40, 1);
    l_s = "";
    if (l_entry) {
        l_s = l_entry;
    } else {
        l_i = 0;
        while (l_i < l_bullets && l_i < 28) {
            l_s = l_s + "*";
            l_i = l_i + 1;
        }
    }
    PromptBullets = Text(FDark, l_s, l_fx + Edge + U, l_y, 45, 28);
    Cursor.SetImage(Img.ink.Scale(Math.Int(CharW / 2), LineH));
    Cursor.SetX(l_fx + Edge + U + PromptBullets.w);
    Cursor.SetY(l_y);
    Cursor.SetZ(46);
    PromptActive = 1;
}

# ------------------------------------------------------------------ callbacks
Blink = 0;
fun OnRefresh() {
    Blink = Blink + 1;
    if (Blink >= 30) Blink = 0;
    if (PromptActive) Cursor.SetOpacity(1);
    else if (NLines > 0) {
        if (Blink < 18) Cursor.SetOpacity(1); else Cursor.SetOpacity(0);
    }
}
Plymouth.SetRefreshFunction(OnRefresh);

# Plymouth's progress is a time estimate and keeps running while a prompt waits for input.
# The bar holds still during a prompt and afterwards runs from the held value to 100 %.
fun OnProgress(l_duration, l_progress) {
    Now = l_duration;
    ProgLast = l_progress;
    if (!Booting || PromptActive) return;
    l_f = ProgBase;
    if (ProgFrom < 1) l_f = ProgBase + (l_progress - ProgFrom) * (1 - ProgBase) / (1 - ProgFrom);
    if (l_f < ProgShown) l_f = ProgShown;
    ProgShown = l_f;
    ShowProgress(l_f);
}
Plymouth.SetBootProgressFunction(OnProgress);

# Plymouth sends 100 % only when it quits; the last frame shows it
fun OnQuit() {
    if (Booting) ShowProgress(1);
}
Plymouth.SetQuitFunction(OnQuit);

fun OnSystemUpdate(l_progress) {
    ShowProgress(l_progress / 100);
}
Plymouth.SetSystemUpdateFunction(OnSystemUpdate);

fun OnStatus(l_status) {
    if (Booting) AddLine(T.start + "  " + Unescape(l_status));
    else AddLine(T.stop + "  " + Unescape(l_status));
}
Plymouth.SetUpdateStatusFunction(OnStatus);

fun OnRootMounted() {
    AddLine(T.rootfs);
}
Plymouth.SetRootMountedFunction(OnRootMounted);

fun OnMessage(l_text) {
    AddLine(T.message + "  " + l_text);
}
Plymouth.SetDisplayMessageFunction(OnMessage);

fun OnPassword(l_prompt, l_bullets) {
    ShowPrompt(l_prompt, NULL, l_bullets);
}
Plymouth.SetDisplayPasswordFunction(OnPassword);

fun OnQuestion(l_prompt, l_entry) {
    ShowPrompt(l_prompt, l_entry, 0);
}
Plymouth.SetDisplayQuestionFunction(OnQuestion);

fun OnNormal() {
    if (PromptActive) {
        ProgBase = ProgShown;
        ProgFrom = ProgLast;
        HidePrompt();
        Cursor.SetImage(Img.lit.Scale(CharW, LineH));
        Cursor.SetZ(30);
    }
}
Plymouth.SetDisplayNormalFunction(OnNormal);

ShowProgress(0);
