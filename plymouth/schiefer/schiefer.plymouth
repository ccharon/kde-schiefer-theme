[Plymouth Theme]
Name=Schiefer
Description=Workstation console: machine banner, systemd units as they start, progress
ModuleName=script

[script]
# images of the system palette and the script with the machine details, both written by
# schiefer-plymouth-info (dracut module 90schiefer-plymouth)
ImageDir=/var/lib/schiefer/plymouth/images
ScriptFile=/var/lib/schiefer/plymouth/schiefer.script
